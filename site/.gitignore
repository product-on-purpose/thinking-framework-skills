# Astro / Node build artifacts
node_modules/
dist/
.astro/
# package-lock.json IS committed (CI uses `npm ci` for reproducible builds).

# Generated content pages are written by ../scripts/gen-site.mjs at build time.
# They are NOT committed (the skills are the source of truth; the site is a view).
src/content/docs/frameworks/
src/content/docs/families/
src/content/docs/recipes/
src/content/docs/evidence/
# explore/ is mixed: the lens + map pages are generated, chooser.mdx is hand-authored.
src/content/docs/explore/*
!src/content/docs/explore/chooser.mdx
# generated data consumed by components at build time
src/generated/
