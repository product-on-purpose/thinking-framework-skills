---
// Footer override: renders Starlight's default footer, then a small version
// label sourced from the generated site-meta.json (library.json version).
import Default from '@astrojs/starlight/components/Footer.astro';
import meta from '../generated/site-meta.json';
---

<Default><slot /></Default>

<div class="tfs-version">
  Thinking Framework Skills <span>v{meta.version}</span> &middot; {meta.skillCount} frameworks
</div>

<style>
  .tfs-version {
    margin-top: 1.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--sl-color-gray-6);
    font-size: 0.75rem;
    color: var(--sl-color-gray-4);
    text-align: center;
  }
  .tfs-version span { font-variant-numeric: tabular-nums; color: var(--sl-color-gray-3); }
</style>
